{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": "Information",
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/log-.txt",
                    "rollingInterval": "Day"
                }
            }
        ]
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "PUT_YOUR_CONNECTION_STRING_HERE"
    },
    "Redis": {
        "ConnectionString": "localhost:6379",
        "InstanceName": "OnlineStore:"
    },
    "AppSettings": {
        "BaseUrl": "http://localhost:5188/"
    },
    "Stripe": {
        "SecretKey": "PUT_YOUR_STRIPE_SECRET_KEY_HERE",
        "PublishableKey": "PUT_YOUR_STRIPE_PUBLISHABLE_KEY_HERE",
        "WebhookSecret": "PUT_YOUR_STRIPE_WEBHOOK_SECRET_HERE"
    },
    "Authevo": {
        "SecretKey": "PUT_YOUR_AUTHEVO_SECRET_KEY_HERE"
    },
    "JwtSettings": {
        "Issuer": "OnlineStore",
        "Audience": "OnlineStore.Client",
        "Key": "PUT_YOUR_JWT_SECRET_KEY_HERE",
        "AccessTokenExpirationMinutes": 15,
        "RefreshTokenExpirationDays": 7
    },
    "EmailSettings": {
        "SenderEmail": "PUT_YOUR_EMAIL_HERE",
        "Host": "smtp.gmail.com",
        "SenderName": "Online Store",
        "Port": 587,
        "Username": "PUT_YOUR_EMAIL_HERE",
        "Password": "PUT_YOUR_EMAIL_APP_PASSWORD_HERE"
    }
}